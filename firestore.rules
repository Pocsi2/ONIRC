rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function keepsPublicationState() {
      // Browser clients can never create a public state or silently retract
      // one. The trusted archive worker bypasses rules for those atomic changes.
      return request.resource.data.visibility == resource.data.visibility
        || (resource.data.visibility != "public" && request.resource.data.visibility != "public");
    }

    match /users/{userId} {
      allow read, create, update, delete: if owns(userId);

      match /dreams/{dreamId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && request.resource.data.visibility != "public";
        allow update: if owns(userId) && keepsPublicationState();
      }

      // Server-managed references prove ownership without placing a UID or a
      // source-memory identifier in a document read by the public.
      match /publicationLinks/{dreamId} {
        allow read: if owns(userId);
        allow write: if false;
      }
    }

    // The public feed is served by the trusted Worker, which filters a closed
    // projection schema before responding. Direct Firestore reads stay denied
    // so a malformed or inherited document can never leak through a query.
    match /publicDreams/{publicDreamId} {
      allow read, write: if false;
    }

    // Reports contain private reporter metadata and are never client-readable.
    match /moderationReports/{reportId} {
      allow read, write: if false;
    }
  }
}
