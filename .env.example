# Onirc is a static GitHub Pages experience. Keep the archive frozen by default.
NEXT_PUBLIC_PUBLIC_ARCHIVE_STATE=frozen

# Only set both variables after the trusted Cloudflare Worker is deployed,
# its legacy cleanup has been verified, and Firestore rules/indexes are live.
# NEXT_PUBLIC_PUBLIC_ARCHIVE_STATE=available
# NEXT_PUBLIC_PUBLIC_ARCHIVE_API_URL=https://onirc-public-archive.<account-subdomain>.workers.dev
