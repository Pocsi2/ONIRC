{
  "name": "onirc-public-archive",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "onirc-production",
    "FIRESTORE_DATABASE_ID": "(default)",
    "ALLOWED_ORIGINS": "https://pocsi2.github.io,http://localhost:3000,http://127.0.0.1:3000"
  },
  "secrets": {
    "required": [
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
      "MIGRATION_ADMIN_UIDS"
    ]
  }
}
